# Postgres accessed by the in-process better-auth instance (@cvsa/core).
DATABASE_URL=postgres://cvsa:password@localhost:5432/cvsa
MEILI_MASTER_KEY=0712041211241099
MEILI_API_URL=http://127.0.0.1:7700

# Backend REST API origin that the client-side form islands post to.
PUBLIC_API_URL=https://api.dev.projectcvsa.com

# Session signing secret for better-auth. Must be identical to the backend's
# value (apps/backend/.env), and NODE_ENV must match the backend's too — the
# __Secure- session cookie name prefix derives from it. Leaving it unset works
# in development (both processes then share better-auth's default), but
# production fails to boot without it.
BETTER_AUTH_SECRET=
