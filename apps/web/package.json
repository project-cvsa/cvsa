{
	"name": "@cvsa/web",
	"type": "module",
	"version": "0.3.0",
	"scripts": {
		"dev": "bunx --bun astro dev --host 0.0.0.0 --port 10199",
		"build": "bunx --bun astro build && bun build dist/server/entry.mjs --target bun --outfile dist/server/entry.mjs --external opencc",
		"preview": "bunx --bun astro preview --port 10199",
		"astro": "bunx --bun astro",
		"test": "bunx --bun vitest run",
		"typecheck": "bunx --bun tsc --noEmit"
	},
	"dependencies": {
		"@ark-ui/solid": "^5.36.2",
		"@astrojs/node": "11.1.6",
		"@astrojs/solid-js": "7.0.2",
		"@cvsa/authentication": "workspace:*",
		"@cvsa/catalog": "workspace:*",
		"@cvsa/contracts": "workspace:*",
		"@cvsa/db": "workspace:*",
		"@elysiajs/eden": "^1.4.9",
		"@fanee/core": "^0.8.1",
		"@fanee/node": "^0.8.1",
		"@fanee/solid": "^0.8.1",
		"@internationalized/date": "3.12.4",
		"accept-language-parser": "^1.5.0",
		"astro": "7.3.3",
		"class-variance-authority": "0.7.1",
		"clsx": "^2.1.1",
		"lucide-solid": "^1.46.0",
		"opencc": "^1.4.1",
		"overlayscrollbars": "^2.17.0",
		"resolve-accept-language": "^3.2.2",
		"solid-js": "^1.9.14",
		"tailwind-merge": "3.7.0",
		"wikiparser-node": "^1.45.0"
	},
	"devDependencies": {
		"@fanee/vite": "^0.8.3",
		"@types/accept-language-parser": "^1.5.8",
		"@types/fs-extra": "^11.0.4",
		"@unocss/astro": "^66.7.5",
		"@unocss/preset-mini": "^66.7.5",
		"@unocss/reset": "^66.7.5",
		"elysia": "^1.4.30",
		"fs-extra": "^11.3.6",
		"postcss-load-config": "^6.0.1",
		"postcss-preset-env": "^11.3.2",
		"unocss": "^66.7.5",
		"vite": "^8.1.4",
		"vitest": "^5.0.1"
	}
}
