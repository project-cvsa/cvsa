---
import { cn } from "@lib/cn";

interface Props {
	label: string;
	class?: string;
}

const { label, class: className } = Astro.props;
---

<div class={cn("flex flex-col gap-2", className)}>
	<span class="ts-label text-surface bg-surface-inverted px-2.5 py-1 self-start leading-none">
		{label}
	</span>
	<div class="ts-body text-primary min-w-0">
		<slot />
	</div>
</div>
