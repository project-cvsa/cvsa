---
import { getThemeColorVariables } from "@lib/theme";
import "./global.css";
import {
	CLIENT_I18N_SCRIPT_ID,
	serializeClientI18nPayload,
	type ClientI18nPayload,
} from "@lib/i18n/payload";
import { defaultLanguage } from "@lib/i18n/const";
import { getLocale, i18nServer } from "@lib/i18n/server";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	canonicalURL?: URL;
	type?: "website" | "article";
	i18nNamespace?: string;
}

const { title, description, i18nNamespace } = Astro.props;
const { language } = getLocale(Astro.request);
const themeCookie = Astro.cookies.get("theme");
const theme = themeCookie?.value || "system";
const themeCSS = getThemeColorVariables(theme);
let clientI18n: ClientI18nPayload | undefined;
if (i18nNamespace) {
	const fullI18nNamespace = `web:client:${i18nNamespace}`;
	const namespaceResources = i18nServer.getTranslationsForNamespace(fullI18nNamespace);
	const currentLocaleMessages = namespaceResources?.[language] ?? {};
	const fallbackLocaleMessages = namespaceResources?.[defaultLanguage] ?? {};
	const clientNamespaceResources =
		language === defaultLanguage
			? { [language]: currentLocaleMessages }
			: {
					[defaultLanguage]: fallbackLocaleMessages,
					[language]: currentLocaleMessages,
				};
	clientI18n = {
		locale: language,
		resources: {
			[fullI18nNamespace]: clientNamespaceResources,
		},
	};
}
const clientI18nJson = clientI18n ? serializeClientI18nPayload(clientI18n) : undefined;
---

<!DOCTYPE html>
<html lang={language} class="scroll-smooth">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		{clientI18nJson ? (
	<script
		id={CLIENT_I18N_SCRIPT_ID}
		type="application/json"
		is:inline
		set:html={clientI18nJson}
	></script>
) : null}

		<title>{title}</title>
		<meta name="description" content={description}>
		<meta name="robots" content="index, follow">

		<link rel="icon" href="/favicon.ico">
		<link rel="apple-touch-icon" href="/apple-touch-icon.png">
		<link rel="manifest" href="/site.webmanifest">

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono&family=Outfit:wght@100..900&display=swap"
			rel="stylesheet"
		>
		<style id="cvsa-color-vars" set:html={themeCSS} is:global>
		</style>

		<slot name="head" />
	</head>

	<body class="overflow-x-hidden">
		<slot />
		<script>
		import { OverlayScrollbars } from "overlayscrollbars";

		const scrollTargets = ".cvsa-scroll, .overflow-auto, .overflow-x-auto, .overflow-y-auto";
		const instances = new Map<HTMLElement, ReturnType<typeof OverlayScrollbars>>();
		let observer: MutationObserver | undefined;
		let scheduled = false;
		function syncScrollbars() {
			scheduled = false;
			for (const [element, instance] of instances) {
				if (!element.isConnected) {
					instance.destroy();
					instances.delete(element);
				}
			}
			document.querySelectorAll<HTMLElement>(scrollTargets).forEach((element) => {
				if (
					instances.has(element) ||
					element.matches(
						"[data-overlayscrollbars-viewport], [data-overlayscrollbars-content]"
					)
				)
					return;
				instances.set(
					element,
					OverlayScrollbars(element, {
						scrollbars: {
							theme: "os-theme-cvsa",
							autoHide: "leave",
							autoHideDelay: 300,
						},
					})
				);
			});
		}
		function initScrollbars() {
			OverlayScrollbars(document.body, {
				scrollbars: { theme: "os-theme-cvsa", autoHide: "leave", autoHideDelay: 400 },
			});
			syncScrollbars();
			observer?.disconnect();
			observer = new MutationObserver(() => {
				if (!scheduled) {
					scheduled = true;
					requestAnimationFrame(syncScrollbars);
				}
			});
			observer.observe(document.body, { childList: true, subtree: true });
		}
		document.addEventListener("astro:before-swap", () => {
			observer?.disconnect();
			for (const instance of instances.values()) instance.destroy();
			instances.clear();
			OverlayScrollbars(document.body)?.destroy();
		});
		document.addEventListener("astro:page-load", initScrollbars);
		if (document.readyState === "loading")
			document.addEventListener("DOMContentLoaded", initScrollbars, { once: true });
		else initScrollbars();
		</script>
	</body>
</html>
