---
import Layout from "@layouts/Layout.astro";
import Condition from "@components/Condition.astro";
import Header from "@layouts/Header.astro";
import { getLocale, i18nServer } from "@lib/i18n/server";
import { AppError, songService, type SongDetailsResponseDto } from "@cvsa/core";
import Card from "@layouts/Card.astro";
import Field from "@layouts/Field.astro";
import Heading1 from "@components/typography/Heading1.astro";
import { renderWiki } from "@lib/wiki";
import "@components/typography/Article.css";
import { formatDateTime, formatDuration, localizedName, pickLyric } from "@lib/localize";
import Pencil from "lucide-solid/icons/pencil";

const { id } = Astro.params;
const { language } = getLocale(Astro.request);
const t = i18nServer.getT({ locale: language, namespace: "server" });
let data: SongDetailsResponseDto | undefined;
try {
	data = await songService.getDetails(Number.parseInt(id || "", 10) || 0);
} catch (e) {
	if (AppError.isAppError(e)) {
		return new Response(null, {
			status: e.statusCode,
			statusText: e.code,
		});
	} else {
		return new Response(null, {
			status: 500,
			statusText: "Internal Server Error",
		});
	}
}
if (!data)
	return new Response(null, {
		status: 404,
	});
const details: SongDetailsResponseDto = data;
const introduction = renderWiki(details.description ?? "", {
	data: details,
	entity: "song",
	language,
});

const songName = localizedName(details, language) || details.name || "";
const singers = details.singers.map((singer) => localizedName(singer, language));
const duration = formatDuration(details.duration);
const publishedAt = formatDateTime(details.publishedAt);

const lyric = pickLyric(details.lyrics, language);
const lyricText = lyric?.plainText ?? lyric?.lrc ?? "";
const lyricBaseLanguage = lyric?.language?.split("-")[0] ?? "";
const lyricLanguage =
	lyricBaseLanguage === "zh"
		? t("song.lang.zh.name")
		: lyricBaseLanguage === "ja" || lyricBaseLanguage === "jp"
			? t("song.lang.jp.name")
			: lyricBaseLanguage;

const uploaderRoleNames = new Set(["uploader", "投稿", "投稿者", "post", "contributor"]);
const uploaderNames = details.artists
	.filter((a) => uploaderRoleNames.has(a.role.name.toLowerCase()))
	.map((a) => localizedName(a, language))
	.filter(Boolean);

const staffByRole = new Map<number, { role: string; artists: string[] }>();
for (const artist of details.artists) {
	const entry = staffByRole.get(artist.role.id) ?? {
		role: localizedName(artist.role, language),
		artists: [],
	};
	entry.artists.push(localizedName(artist, language));
	staffByRole.set(artist.role.id, entry);
}
const staff = [...staffByRole.values()];
---

<Layout title={`${songName} - 中V档案馆`}>
	<style is:global>
	.wireframe {
		background: repeating-linear-gradient(
			-45deg,
			var(--background),
			var(--background) 13px,
			var(--wireframe-line) 13px,
			var(--wireframe-line) 14px
		);
		border: var(--wireframe-line) 1px solid;
	}
	.highlight {
		position: relative;
		display: inline-block;
		z-index: 1;
		text-shadow: 0px 2px 4px var(--highlight-shadow-color);
	}
	.highlight::after {
		content: "";
		width: 100%;
		height: 8px;
		background-color: var(--highlight-color);
		position: absolute;
		left: 0;
		bottom: 2px;
		z-index: -1;
	}
	.lrc {
		white-space: pre-line;
	}
	</style>
	<Header />

	<div class="flex mx-auto max-w-[110rem]">
		<aside class="relative hidden lg:flex md:w-60 lg:w-64 xl:w-80 items-center min-h-screen">
			<div
				class="fixed top-24 w-[inherit] h-[calc(100vh-10rem)] overflow-y-auto py-3 px-4 wireframe"
			>
				<span class="font-[IBM_Plex_Mono] opacity-50 uppercase">Left Sidebar</span>
			</div>
		</aside>

		<main
			class="flex-1 py-6 px-4 max-lg:max-w-2xl mx-auto min-w-0 grid grid-cols-1 lg:grid-cols-2 gap-8 xl:gap-12"
		>
			<div class="flex flex-col gap-6">
				<Condition condition={details.coverUrl}>
					<div class="w-full">
						<img
							alt={t("song.cover.alt")}
							src={details.coverUrl ?? ""}
							referrerpolicy="no-referrer"
						>
					</div>
				</Condition>
				<Card>
					<Fragment slot="title">{t("song.intro.title")}</Fragment>
					<Fragment slot="title-en">Introduction</Fragment>
					<Fragment slot="body">
						<article class="ts-article" set:html={introduction} />
					</Fragment>
				</Card>

				<Card>
					<Fragment slot="title">{t("song.lyrics.title")}</Fragment>
					<Fragment slot="title-en">Lyrics</Fragment>
					<Fragment slot="body">
						<Condition condition={lyricText.length > 0}>
							<div class="flex items-center gap-2">
								<span
									class="ts-overline color-surface px-2.5 py-1 bg-surface-inverted border border-border"
								>
									{lyricLanguage}
								</span>
								<Condition condition={lyric?.isTranslated}>
									<span class="ts-caption color-tertiary">
										{t("song.lyrics.translated")}
									</span>
								</Condition>
							</div>
							<p class="lrc ts-body color-primary mt-4 leading-7">
								{lyricText}
							</p>
						</Condition>
					</Fragment>
				</Card>
			</div>
			<div class="flex flex-col gap-6">
				<div class="w-full">
					<Card>
						<Fragment slot="title">{t("song.info.title")}</Fragment>
						<Fragment slot="title-en">Information</Fragment>
						<Fragment slot="body">
							<Heading1>
								<span class="highlight">{songName}</span>
							</Heading1>

							<div class="grid grid-cols-2 gap-x-6 gap-y-6 mt-6">
								<Condition condition={singers.length > 0}>
									<Field label={t("song.info.field.singers")}>
										{singers.join("、")}
									</Field>
								</Condition>

								<Field label={t("song.info.field.duration")}>{duration}</Field>

								<Condition condition={uploaderNames.length > 0}>
									<Field label={t("song.info.field.uploader")}>
										{uploaderNames.join("、")}
									</Field>
								</Condition>

								<Condition condition={details.externalLinks.length > 0}>
									<Field label={t("song.info.field.links")}>
										<div class="flex flex-wrap gap-x-3 gap-y-1">
											{details.externalLinks.map((link) => (
												<a
													href={link.url}
													target="_blank"
													rel="noopener noreferrer"
													class="underline underline-offset-4 decoration-border hover:decoration-primary transition-colors"
											>
												{link.label ?? link.platform ?? "link"}
											</a>
										))}
										</div>
									</Field>
								</Condition>

								<Field label={t("song.info.field.time")}>{publishedAt}</Field>

								<Field label={t("song.info.field.plays")}>—</Field>
							</div>
						</Fragment>
					</Card>
				</div>

				<Condition condition={staff.length > 0}>
					<Card>
						<Fragment slot="title">{t("song.staff.title")}</Fragment>
						<Fragment slot="title-en">Staff</Fragment>
						<Fragment slot="body">
							<div class="grid grid-cols-2 gap-x-6 gap-y-6">
								{staff.map((entry) => (
									<Field label={entry.role}>{entry.artists.join("、")}</Field>
								))}
							</div>
						</Fragment>
					</Card>
				</Condition>
			</div>
		</main>

		<aside class="relative hidden md:w-60 lg:w-64 xl:w-80 2xl:flex items-center min-h-screen">
			<div
				class="fixed top-24 w-[inherit] h-[calc(100vh-10rem)] overflow-y-auto py-3 px-4 wireframe"
			>
				<div class="w-full flex flex-col gap-3">
					<a
						href={`/song/${details.id}/edit`}
						class="inline-flex w-full h-11 items-center justify-center gap-2 border border-border bg-transparent px-4 ts-label color-primary transition-colors hover:bg-surface-container-medium focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
					>
						<Pencil size={18} />
						{t("song.edit.action")}
					</a>
					<div class="w-full flex justify-end">
						<span class="font-[IBM_Plex_Mono] opacity-50 uppercase">Right Sidebar</span>
					</div>
				</div>
			</div>
		</aside>
	</div>
</Layout>
