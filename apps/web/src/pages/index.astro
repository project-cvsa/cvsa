---
import UnderConstruction from "@components/pages/UnderConstruction.astro";
import { getLocale, i18nServer } from "@lib/i18n/server";

const { language } = getLocale(Astro.request);
const t = i18nServer.getT({ locale: language });

const linksZh = [
	{ href: "https://qm.qq.com/q/7RXTNmvmUM", text: t("home.link.join") },
	{ href: "https://docs.projectcvsa.com/zh", text: t("home.link.docs") },
];

const linksEn = [
	{ href: "mailto:join@projectcvsa.com", text: t("home.link.join") },
	{ href: "https://docs.projectcvsa.com/en", text: t("home.link.docs") },
];

const links = language.startsWith("zh") ? linksZh : linksEn;
---

<UnderConstruction
	title={t("home.title")}
	logoVariant={language.startsWith("zh") ? "chinese" : "latin"}
	description={t("home.description")}
	{links}
/>
