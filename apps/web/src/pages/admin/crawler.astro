---
import Layout from "@layouts/Layout.astro";
import Header from "@layouts/Header.astro";
import CrawlerDashboard from "@components/pages/admin/CrawlerDashboard";

const user = Astro.locals.user;
if (!user) {
	return Astro.redirect(`/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}
if (user.roleName !== "OWNER" && user.roleName !== "admin") {
	return Astro.redirect("/403");
}
---

<Layout title="Crawler Control Panel - CVSA" i18nNamespace="crawler">
	<Header />
	<main class="mx-auto w-full max-w-7xl px-4 py-8 md:px-8">
		<CrawlerDashboard client:only="@cvsa/solid-i18n" />
	</main>
</Layout>
