---
import Layout from "@layouts/Layout.astro";
import RegisterForm from "@components/pages/auth/RegisterForm";
import { getLocale, i18nServer } from "@lib/i18n/server";
import { getCurrentUser } from "@lib/auth";
import Header from "@layouts/Header.astro";

const { language, baseLanguage } = getLocale(Astro.request);
const t = i18nServer.getT({ locale: language });

const user = await getCurrentUser(Astro.request);
if (user) {
	return Astro.redirect("/");
}
---

<Layout title={t("auth.register.title")}>
	<Header />
	<main class="flex min-h-screen items-center justify-center px-4 py-10">
		<div class="flex w-full max-w-[500px] flex-col gap-8">
			<h1 class="ts-heading-1 text-display font-300">{t("auth.register.title")}</h1>
			<RegisterForm
				client:load
				usernameLabel={t("auth.field.username")}
				emailLabel={t("auth.field.email.optional")}
				passwordLabel={t("auth.field.password")}
				passwordHelperText={t("auth.field.password.min")}
				submitLabel={t("auth.action.register")}
				genericError={t("auth.error.generic")}
				networkError={t("auth.error.network")}
				locale={baseLanguage}
				redirectTo="/"
			/>
			<div class="ts-body mt-1 flex items-center justify-end text-tertiary">
				<a href="/login" class="transition-colors hover:text-primary">
					{t("auth.link.login")}
				</a>
			</div>
		</div>
	</main>
</Layout>
