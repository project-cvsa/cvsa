{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"],
	"compilerOptions": {
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"paths": {
			"@layouts/*": ["./src/components/layout/*"],
			"@components/*": ["./src/components/*"],
			"@lib/*": ["./src/lib/*"]
		}
	}
}
