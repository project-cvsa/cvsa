# Copy to `.env` for local development, or to `.env.test` for tests. Bun loads
# `.env.test` automatically while NODE_ENV=test, which is what `bun test` sets.
# Every value here matches the default in packages/env, so a local run without
# this file still starts against the docker-compose services.

# Bearer token required by the control plane. The process refuses to start
# without it, and every route answers 401 while it is unset.
CONTROL_API_TOKEN=dev-control-token

CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=16413

# Redis backs the job queue and the distributed network rate limiter.
REDIS_URL=redis://127.0.0.1:6379

# The crawler owns its own database (docker-compose service `snapshot-db`); it
# never reads DATABASE_URL. Leave this unset to take the default, which is
# `cvsa_snapshot` — or `cvsa_snapshot_test` while NODE_ENV=test, so a test run
# never resets local development data.
# SNAPSHOT_DATABASE_URL=postgres://cvsa:password@127.0.0.1:5433/cvsa_snapshot

LOG_LEVEL=info
OTEL_SERVICE_NAME=cvsa-crawler
OTEL_SERVICE_VERSION=0.0.0
