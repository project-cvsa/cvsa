# Environment used by `bun test` (Bun loads `.env.test` when NODE_ENV=test).
# Tests run against the dedicated `cvsa_test` database — never `cvsa` — so a
# test run cannot reset local development data.
DATABASE_URL=postgres://cvsa:password@localhost:5432/cvsa_test
