# CVSA Configuration (.env)
#
# Copy this file to `.env` in the project root:
#   cp .env.example .env
#
# Docker Compose and Bun automatically load `.env` from the project root.

# Site & Public Routing
# Public domain served by your host reverse proxy (Caddy / Nginx).
SITE_ADDRESS=projectcvsa.com
IMAGE_REGISTRY=ghcr.io/project-cvsa
IMAGE_TAG=latest

# Host binding address for published ports (default 127.0.0.1 for local/reverse-proxy).
# Set to 0.0.0.0 if you want to expose ports directly to external networks.
WEB_BIND_IP=127.0.0.1
BACKEND_BIND_IP=127.0.0.1
CRAWLER_BIND_IP=127.0.0.1
EMBEDDING_BIND_IP=127.0.0.1
POSTGRES_BIND_IP=127.0.0.1
SNAPSHOT_DB_BIND_IP=127.0.0.1
MEILI_BIND_IP=127.0.0.1
REDIS_BIND_IP=127.0.0.1
REDIS_CACHE_BIND_IP=127.0.0.1

# Service Ports (change here to remap any port)
WEB_PORT=10199
BACKEND_PORT=16412
CRAWLER_PORT=16413
EMBEDDING_PORT=14900
POSTGRES_PORT=5432
SNAPSHOT_DB_PORT=5433
MEILI_PORT=7700
REDIS_PORT=6379
REDIS_CACHE_PORT=6380

# Models & File Storage
# Directory on the host that holds ONNX model assets:
#   <MODEL_DIR>/embedding/model.onnx        (Jina embedding 1024d)
#   <MODEL_DIR>/akari/3.17.onnx             (Akari song classifier)
# Tokenizers are automatically downloaded on first boot into `<MODEL_DIR>/.cache/huggingface`.
MODEL_DIR=./model

# Databases & Credentials
# Primary Database (PostgreSQL)
POSTGRES_USER=cvsa
POSTGRES_PASSWORD=password
POSTGRES_DB=cvsa
# Primary Database Memory Limits & Sizing (Default tuned for 2GB container limit)
DB_MEMORY_LIMIT=2G
DB_SHARED_PRELOAD_LIBRARIES=pg_stat_statements
DB_SHARED_BUFFERS=512MB
DB_EFFECTIVE_CACHE_SIZE=1536MB
DB_WORK_MEM=16MB
DB_MAINTENANCE_WORK_MEM=128MB

# Snapshot Database (TimescaleDB)
SNAPSHOT_DB_USER=cvsa
SNAPSHOT_DB_PASSWORD=password
SNAPSHOT_DB_NAME=cvsa_snapshot
# Snapshot Database Memory Limits & Sizing (Default tuned for 4GB container limit)
SNAPSHOT_DB_MEMORY_LIMIT=4G
SNAPSHOT_DB_SHARED_PRELOAD_LIBRARIES=timescaledb,pg_stat_statements
SNAPSHOT_DB_SHARED_BUFFERS=1GB
SNAPSHOT_DB_EFFECTIVE_CACHE_SIZE=3GB
SNAPSHOT_DB_WORK_MEM=16MB
SNAPSHOT_DB_MAINTENANCE_WORK_MEM=256MB
SNAPSHOT_DB_MAX_WORKERS=16
SNAPSHOT_DB_PARALLEL_WORKERS=8

# Crawler Memory Limit
CRAWLER_MEMORY_LIMIT=1536M

# Redis Cache Memory Limit
REDIS_CACHE_MAXMEMORY=512mb

# Meilisearch (master key must be at least 16 bytes)
MEILI_MASTER_KEY=cvsa_meili_master_key_16bytes
MEILI_ENV=production

# Authentication & Web
BETTER_AUTH_SECRET=change_me_in_production_at_least_32_chars
BETTER_AUTH_URL=https://api.projectcvsa.com
COOKIE_DOMAIN=.projectcvsa.com
WEB_ORIGINS=https://zh.projectcvsa.com,https://en.projectcvsa.com,https://zh.dev.projectcvsa.com,https://en.dev.projectcvsa.com

# Web -> Backend API origin used by Eden Treaty in the browser.
PUBLIC_API_URL=https://api.projectcvsa.com

# Crawler Control Plane
CONTROL_API_TOKEN=change_me_in_production_token

# Deploy Webhook (optional, for automated deployments)
DEPLOY_WEBHOOK_SECRET=
DEPLOY_PORT=9420

# Optional: GitHub Container Registry credentials
GHCR_USERNAME=
GHCR_PULL_TOKEN=
