{
	"remoteCache": {
		"enabled": true
	},
	"$schema": "https://v2-11-2.turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".output/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"docs#build": {
			"outputs": ["out/**"]
		},
		"lint": {
			"inputs": ["tests/**.ts", "src/**.ts", "biome.json", ".biome*"]
		},
		"test": {
			"dependsOn": ["^build"],
			"inputs": [
				"src/**.ts",
				"tests/**.ts",
				"tsconfig.json",
				"$TURBO_ROOT$/packages/typescript-config/base.json"
			]
		},
		"test:coverage": {},
		"setup": {
			"cache": false,
			"dependsOn": [
				"@cvsa/db#push",
				"@cvsa/db#test:setup",
				"@cvsa/db#gen",
				"@cvsa/snapshot-db#gen",
				"@cvsa/snapshot-db#test:setup"
			]
		},
		"setup:ci": {
			"cache": false,
			"dependsOn": [
				"@cvsa/db#test:setup",
				"@cvsa/db#gen",
				"@cvsa/snapshot-db#gen",
				"@cvsa/snapshot-db#test:setup"
			]
		},
		"@cvsa/db#test:setup": {
			"cache": false
		},
		"@cvsa/db#push": {
			"cache": false
		},
		"@cvsa/db#gen": {
			"cache": false
		},
		"@cvsa/snapshot-db#gen": {
			"cache": false
		},
		"@cvsa/snapshot-db#test:setup": {
			"cache": false
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"inputs": [
				"src/**.ts",
				"tsconfig.json",
				"$TURBO_ROOT$/packages/typescript-config/base.json"
			]
		},
		"@cvsa/db#test:reset": {
			"cache": false
		},
		"@cvsa/snapshot-db#test:reset": {
			"cache": false
		},
		"//test:reset": {
			"dependsOn": ["@cvsa/db#test:reset", "@cvsa/snapshot-db#test:reset"]
		}
	}
}
