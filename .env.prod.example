# Site & Reverse Proxy
SITE_ADDRESS=cvsa.example.com
IMAGE_REGISTRY=ghcr.io/project-cvsa
# Pinned by the deploy workflow to `sha-<commit>` (rolls back on failed health checks).
IMAGE_TAG=latest

# Directory on the host that holds every ONNX asset. It is mounted read-only at
# `/app/model` in the `inference` service (and as a fallback in `crawler`):
#   <MODEL_DIR>/embedding/model.onnx            (jina-embedding-v3-m2v-1024)
#   <MODEL_DIR>/embedding/tokenizer.json
#   <MODEL_DIR>/embedding/tokenizer_config.json
#   <MODEL_DIR>/akari/3.17.onnx                 (Akari classifier)
# The inference engine verifies each file against its pinned SHA-256 manifest
# and stays unready until all of them match.
MODEL_DIR=./model

# Primary Database (PostgreSQL)
POSTGRES_USER=cvsa
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=cvsa

# Snapshot Database (TimescaleDB)
SNAPSHOT_DB_USER=cvsa
SNAPSHOT_DB_PASSWORD=change_me_in_production
SNAPSHOT_DB_NAME=cvsa_snapshot

# Redis
REDIS_MAXMEMORY=512mb

# Meilisearch
MEILI_MASTER_KEY=change_me_in_production

# Authentication & Web
BETTER_AUTH_SECRET=change_me_in_production_at_least_32_chars
BETTER_AUTH_URL=https://cvsa.example.com
COOKIE_DOMAIN=.cvsa.example.com
WEB_ORIGINS=https://cvsa.example.com

# Crawler Control Plane
CONTROL_API_TOKEN=change_me_in_production_token

# Inference Service (classifier consumed by the crawler via ML_API_URL)
# Paths are resolved inside the container, after `${MODEL_DIR}` is mounted at
# `/app/model`; only override them if the asset layout differs. The port is
# internal only and is never published to the host.
INFERENCE_EMBEDDING_MODEL_PATH=/app/model/embedding/model.onnx
INFERENCE_CLASSIFIER_MODEL_PATH=/app/model/akari/3.17.onnx
INFERENCE_TOKENIZER_PATH=/app/model/embedding
