# Site & Reverse Proxy
SITE_ADDRESS=cvsa.example.com
IMAGE_REGISTRY=ghcr.io/project-cvsa
# Pinned by the deploy daemon to `sha-<commit>` (rolled back on failed health checks).
IMAGE_TAG=latest

# Directory on the host that holds every ONNX asset. It is mounted read-write at
# `/app/model` in `crawler` and `embedding`. Only the weights need to exist up
# front: the HuggingFace tokenizer assets are fetched automatically on first use
# into `HF_HOME=/app/model/.cache/huggingface` and reused from there:
#   <MODEL_DIR>/embedding/model.onnx            (jina-embedding-v3-m2v-1024)
#   <MODEL_DIR>/akari/3.17.onnx                 (Akari classifier)
MODEL_DIR=./model

# Primary Database (PostgreSQL)
POSTGRES_USER=cvsa
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=cvsa

# Snapshot Database (TimescaleDB)
SNAPSHOT_DB_USER=cvsa
SNAPSHOT_DB_PASSWORD=change_me_in_production
SNAPSHOT_DB_NAME=cvsa_snapshot

# Redis
REDIS_MAXMEMORY=512mb

# Meilisearch
MEILI_MASTER_KEY=change_me_in_production

# Authentication & Web
BETTER_AUTH_SECRET=change_me_in_production_at_least_32_chars
BETTER_AUTH_URL=https://cvsa.example.com
COOKIE_DOMAIN=.cvsa.example.com
WEB_ORIGINS=https://cvsa.example.com

# Web -> API origin. Leave empty (recommended) for the same-origin setup: Caddy
# serves `/v2/*` and `/` from SITE_ADDRESS, so the browser calls its own origin
# (`window.location.origin`) and SSR calls `INTERNAL_API_URL` inside the Docker
# network. Set a full origin (e.g. https://api.example.com) only when the API is
# published on a different domain; it is baked into the bundle when the web
# image is built.
PUBLIC_API_URL=
# API origin used by web SSR when PUBLIC_API_URL is empty. Override only if the
# compose service name changes.
INTERNAL_API_URL=http://backend:16412

# Crawler Control Plane
CONTROL_API_TOKEN=change_me_in_production_token

# ==============================================================================
# Deploy Webhook Daemon (host process: `bun run scripts/deploy-daemon.ts`)
#
# The daemon is NOT part of this compose stack; it runs next to it on the host
# and reads `.env.prod` from its working directory for the values below.
# Caddy exposes it at `https://<SITE_ADDRESS>/_deploy/...`, so no extra firewall
# port is required.
# ==============================================================================
# Shared secret for `Authorization: Bearer ...` and `X-Hub-Signature-256` HMACs.
# Generate with: openssl rand -hex 32
DEPLOY_WEBHOOK_SECRET=change_me_in_production_webhook_secret
# Loopback is enough when Caddy proxies `/_deploy` (see `docker/Caddyfile`);
# set `0.0.0.0` only when GitHub calls the daemon directly.
DEPLOY_HOST=127.0.0.1
DEPLOY_PORT=9420
# Directory holding `docker-compose.prod.yml`, `docker/` and `.env.prod`.
# Defaults to the current working directory of the daemon - never hardcoded.
DEPLOY_WORKDIR=
DEPLOY_COMPOSE_FILE=docker-compose.prod.yml
DEPLOY_ENV_FILE=.env.prod
# Optional: lets the daemon pull private GHCR images (`docker login ghcr.io`).
GHCR_USERNAME=
GHCR_PULL_TOKEN=
