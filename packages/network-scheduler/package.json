		"url": "git+https://github.com/project-cvsa/cvsa.git",
		"directory": "packages/network-scheduler"
	},
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
