{
	"name": "@cvsa/db",
	"type": "module",
	"main": "src/index.ts",
	"module": "src/index.ts",
	"scripts": {
		"lint": "bunx --bun biome lint",
		"typecheck": "bunx --bun tsc --noEmit",
		"migrate:generate": "bunx drizzle-kit generate",
		"migrate:deploy": "bun scripts/migrate.ts",
		"push": "bunx drizzle-kit push --force",
		"studio": "bunx drizzle-kit studio",
		"test:setup": "NODE_ENV=test bun scripts/test-setup.ts && NODE_ENV=test bunx drizzle-kit push --force",
		"test:reset": "NODE_ENV=test bun scripts/test-setup.ts && NODE_ENV=test bunx drizzle-kit push --force"
	},
	"devDependencies": {
		"@cvsa/typescript-config": "workspace:*",
		"@types/bun": "latest",
		"drizzle-kit": "1.0.0-rc.5"
	},
	"dependencies": {
		"@cvsa/env": "workspace:*",
		"drizzle-orm": "1.0.0-rc.5",
		"temporal-polyfill": "^1.0.6",
		"zod": "^4.3.6"
	}
}
