{
	"name": "@cvsa/snapshot-db",
	"type": "module",
	"main": "src/index.ts",
	"module": "src/index.ts",
	"version": "0.1.0",
	"scripts": {
		"lint": "bunx --bun biome lint",
		"typecheck": "bunx --bun tsc --noEmit",
		"gen": "bunx --bun prisma contract emit",
		"db:update": "bunx --bun prisma db update --yes",
		"migrate": "bunx --bun prisma migration plan",
		"migrate:deploy": "bunx --bun prisma db migrate",
		"test": "bun test --concurrent",
		"test:setup": "NODE_ENV=test bun scripts/test-setup.ts && NODE_ENV=test bunx --bun prisma db update --yes",
		"test:reset": "NODE_ENV=test bun scripts/test-setup.ts && NODE_ENV=test bunx --bun prisma db update --yes"
	},
	"devDependencies": {
		"@cvsa/typescript-config": "workspace:*",
		"@types/bun": "latest",
		"prisma": "8.0.0-rc.27"
	},
	"dependencies": {
		"@cvsa/env": "workspace:*",
		"@prisma/orm-postgres": "8.0.0-rc.20",
		"temporal-polyfill": "^1.0.6"
	}
}
