{
	"name": "@cvsa/snapshot-db",
	"type": "module",
	"main": "src/index.ts",
	"module": "src/index.ts",
	"version": "0.1.0",
	"scripts": {
		"lint": "bunx --bun biome lint",
		"typecheck": "bunx --bun tsc --noEmit",
		"migrate:generate": "bunx --bun drizzle-kit generate",
		"migrate:deploy": "bun scripts/migrate.ts && bun scripts/ensure-timescale.ts",
		"db:update": "bun scripts/test-setup.ts && bun run push && bun scripts/ensure-timescale.ts",
		"push": "bunx --bun drizzle-kit push --force",
		"test": "bun test --concurrent",
		"test:setup": "NODE_ENV=test bun run db:update",
		"test:reset": "bun run test:setup"
	},
	"devDependencies": {
		"@cvsa/typescript-config": "workspace:*",
		"@types/bun": "latest",
		"drizzle-kit": "1.0.0-rc.5"
	},
	"dependencies": {
		"@cvsa/env": "workspace:*",
		"drizzle-orm": "1.0.0-rc.5",
		"temporal-polyfill": "^1.0.6"
	}
}
