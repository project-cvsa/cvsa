generator client {
	provider = "prisma-client"
	output   = "./generated"
}

datasource db {
	provider = "postgresql"
}

model VideoSnapshot {
	aid        BigInt   @db.BigInt
	capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)
	views      Int
	coins      Int
	likes      Int
	favorites  Int
	shares     Int
	danmakus   Int
	replies    Int

	@@id([aid, capturedAt])
	@@index([aid, capturedAt(sort: Desc)])
	@@index([capturedAt])
	@@map("video_snapshot")
}

/// The single desired-state document for a crawler network runtime. This is a
/// normal PostgreSQL table deliberately kept outside the Timescale hypertable.
model NetworkRuntimeConfig {
	id        String   @id @default("default") @db.VarChar(64)
	revision  Int      @default(1)
	config    Json
	updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

	@@map("network_runtime_config")
}
