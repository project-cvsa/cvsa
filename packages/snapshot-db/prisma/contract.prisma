// use prisma-8

model VideoSnapshot {
  aid        BigInt   @map("aid")
  capturedAt DateTime @default(now()) @map("captured_at")
  views      Int
  coins      Int
  likes      Int
  favorites  Int
  shares     Int
  danmakus   Int
  replies    Int

  @@id([aid, capturedAt])
  @@index([aid, capturedAt])
  @@index([capturedAt])
  @@map("video_snapshot")
}

model NetworkRuntimeConfig {
  id        String   @id @default("default") @map("id")
  revision  Int      @default(1)
  config    Json
  updatedAt DateTime @onCreate(now()) @onUpdate(now()) @map("updated_at")

  @@map("network_runtime_config")
}

model VideoTracking {
  aid              BigInt    @id
  state            String    @default("regular")
  nextSnapshotAt   DateTime  @map("next_snapshot_at")
  leaseUntil       DateTime? @map("lease_until")
  scheduleReason   String    @default("regular") @map("schedule_reason")
  nextMetadataAt   DateTime? @map("next_metadata_at")
  lastViews        Int       @default(0) @map("last_views")
  lastCapturedAt   DateTime? @map("last_captured_at")
  velocity         Float     @default(0)
  targetMilestone  Int?      @map("target_milestone")
  etaHours         Float?    @map("eta_hours")
  publishedAt      DateTime? @map("published_at")
  priority         Int       @default(2)
  consecutiveFails Int       @default(0) @map("consecutive_fails")
  lastError        String?   @map("last_error")
  updatedAt        DateTime  @onCreate(now()) @onUpdate(now()) @map("updated_at")

  @@index([nextSnapshotAt, priority])
  @@index([leaseUntil])
  @@index([nextMetadataAt])
  @@map("video_tracking")
}

model BilibiliVideoMetadata {
  aid             BigInt    @id
  bvid            String    @map("bvid")
  cid             BigInt?   @map("cid")
  videos          Int       @default(1) @map("videos")
  tid             Int?      @map("tid")
  tidV2           Int?      @map("tid_v2")
  tname           String?   @map("tname")
  tnameV2         String?   @map("tname_v2")
  copyright       Int?      @map("copyright")
  pic             String?   @map("pic")
  title           String
  pubdate         DateTime? @map("pubdate")
  ctime           DateTime? @map("ctime")
  description     String?
  descV2          Json?     @map("desc_v2")
  state           Int       @default(0) @map("state")
  duration        Int       @default(0)
  Dynamic         String?   @map("dynamic")
  dimension       Json?     @map("dimension")
  mid             BigInt?   @map("mid")
  ownerName       String?   @map("owner_name")
  ownerFace       String?   @map("owner_face")
  pages           Json?     @map("pages")
  staff           Json?     @map("staff")
  rights          Json?     @map("rights")
  honorReply      Json?     @map("honor_reply")
  tags            Json?     @map("tags")
  videoStatus     String    @default("normal") @map("video_status")
  filterDecision  String    @default("accepted") @map("filter_decision")
  modelScore      Float?    @map("model_score")
  modelVersion    String?   @map("model_version")
  discoverySource String?   @map("discovery_source")
  discoveryContext Json?    @map("discovery_context")
  capturedAt      DateTime  @default(now()) @map("captured_at")
  updatedAt       DateTime  @onCreate(now()) @onUpdate(now()) @map("updated_at")

  @@index([bvid])
  @@index([mid])
  @@index([pubdate])
  @@index([videoStatus])
  @@index([filterDecision])
  @@map("bilibili_video_metadata")
}

model BilibiliVideoMetadataHistory {
  id            BigInt   @id @default(autoincrement()) @map("id")
  aid           BigInt   @map("aid")
  capturedAt    DateTime @default(now()) @map("captured_at")
  changeType    String   @map("change_type")
  changedFields Json     @map("changed_fields")
  snapshot      Json     @map("snapshot")

  @@index([aid, capturedAt])
  @@index([capturedAt])
  @@map("bilibili_video_metadata_history")
}

model BilibiliVideoRelation {
  sourceAid  BigInt   @map("source_aid")
  targetAid  BigInt   @map("target_aid")
  position   Int      @map("position")
  capturedAt DateTime @default(now()) @map("captured_at")

  @@id([sourceAid, targetAid, capturedAt])
  @@index([sourceAid, capturedAt])
  @@index([targetAid])
  @@index([capturedAt])
  @@map("bilibili_video_relation")
}

model CrawlerRuntimeConfig {
  key       String   @id @map("key")
  revision  Int      @default(1)
  config    Json
  updatedAt DateTime @onCreate(now()) @onUpdate(now()) @map("updated_at")

  @@map("crawler_runtime_config")
}

model DiscoverySample {
  aid             BigInt    @id @map("aid")
  bvid            String    @map("bvid")
  title           String
  description     String?
  tags            Json?     @map("tags")
  decision        String    @map("decision")
  modelVersion    String    @map("model_version")
  probabilities   Json      @map("probabilities")
  songProbability Float     @map("song_probability")
  humanLabel      Int?      @map("human_label")
  labeledAt       DateTime? @map("labeled_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([decision])
  @@index([humanLabel])
  @@index([createdAt])
  @@map("discovery_sample")
}

model CrawlerStatsRollup {
  bucketTime  DateTime @map("bucket_time")
  metricGroup String   @map("metric_group")
  metrics     Json     @map("metrics")

  @@id([bucketTime, metricGroup])
  @@index([metricGroup, bucketTime])
  @@map("crawler_stats_rollup")
}
